# Copy to .env and fill in. Never commit .env.

# Server
PORT=8787
DATA_DIR=/data
# Host IP the app binds to. Production: the host's PRIVATE IP (set in the
# host's .env, never committed). Local dev: 127.0.0.1 is the default.
HOST_BIND_IP=127.0.0.1

# Public URL of the deployment (used for documentation and links)
PUBLIC_URL=https://poker.<domain>

# --- Secrets (generate with: openssl rand -hex 32) ---
# Signs session cookies. Rotate = everyone gets logged out.
SESSION_SECRET=change-me

# Shared invite code colleagues must enter to register.
INVITE_CODE=change-me

# Points awarded for finishing positions 1st..Nth (comma-separated).
# Positions beyond the table get 0 points.
POINTS_TABLE=100,75,55,40,30,20,12,8,5,3
